{
	"name": "gofront",
	"version": "1.7.0",
	"author": "Luuk van Venrooij",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/seriva/gofront.git"
	},
	"bugs": {
		"url": "https://github.com/seriva/gofront/issues"
	},
	"homepage": "https://github.com/seriva/gofront#readme",
	"description": "A Go-inspired language that compiles to JavaScript and WebAssembly",
	"keywords": [
		"go",
		"compiler",
		"transpiler",
		"javascript",
		"webassembly",
		"wasm",
		"wasmgc",
		"frontend",
		"type-safe"
	],
	"engines": {
		"node": ">=20"
	},
	"type": "module",
	"files": [
		"src/",
		"stdlib/"
	],
	"bin": {
		"gofront": "src/index.js"
	},
	"scripts": {
		"build": "node scripts/build-examples.js",
		"test": "node test/unit/run.js && node test/e2e/perf/zero-alloc.js && node src/index.js test --dom example/...",
		"test:e2e": "playwright test",
		"test:coverage": "c8 --include='src/**' --reporter=text --reporter=lcov node test/unit/run.js",
		"bench": "node --expose-gc test/e2e/perf/raycast-bench.js && node test/e2e/perf/json-bench.js && node --expose-gc test/e2e/perf/particle-bench.js",
		"check:layers": "node scripts/check-layers.js",
		"format": "biome format --write .",
		"check": "biome check . && node scripts/check-layers.js && sentrux check && sentrux gate && node src/index.js check example/...",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.63.0",
		"c8": "^12.0.0",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.2",
		"lefthook": "^2.1.17",
		"preact": "^11.0.1",
		"serve": "^14.2.6"
	},
	"optionalDependencies": {
		"binaryen": "^132.0.0"
	},
	"gofront": {
		"vendor": {
			"dest": "example/preact/vendor.js",
			"packages": [
				"preact",
				"preact/hooks"
			],
			"globals": {
				"preact": "preact",
				"preact/hooks": [
					"preact/hooks",
					"preact_hooks"
				]
			},
			"namedExports": {
				"preact": [
					"h",
					"render",
					"Component"
				],
				"preact/hooks": [
					"useState",
					"useEffect",
					"useRef",
					"useMemo",
					"useCallback",
					"useReducer"
				]
			}
		}
	}
}
